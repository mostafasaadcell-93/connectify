# Local read-only Market Pricing preview. Copy this file to staging-preview.env.
# staging-preview.env is gitignored. Do not commit it or paste it into chat.
#
# Windows PowerShell, from the Connectify repo:
#   git checkout cursor/market-pricing-7fc1
#   git pull origin cursor/market-pricing-7fc1
#   if (-not (Test-Path market\staging-preview.env)) { Copy-Item market\staging-preview.env.example market\staging-preview.env }
#   notepad market\staging-preview.env
#   node market/staging-preview.mjs
#
# Set the URL exactly as shown. Put the staging anon or publishable key on the second line.
# Leave the service-role key unused. Do not put a password in this file.
# Sign in afterwards in the browser with the existing staging staff user.

